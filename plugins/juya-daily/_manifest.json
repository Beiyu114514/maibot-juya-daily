{
  "manifest_version": 2,
  "id": "com.juya.daily",
  "version": "0.5.0",
  "name": "橘鸦AI早报",
  "description": "订阅 https://daily.juya.uk/ 每日 AI 资讯早报：群内自助订阅，每天定时推送（纯文本 / QQ Markdown / 长图），支持 /早报 即取即看与失败重试。",
  "author": {
    "name": "Beiyu114514",
    "url": "https://github.com/Beiyu114514"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Beiyu114514/maibot-juya-daily",
    "homepage": "https://daily.juya.uk/"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.14.0",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "send.text",
    "send.custom",
    "chat.get_stream_by_group_id",
    "config.get_plugin",
    "send.image",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
